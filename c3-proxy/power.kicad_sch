			(font
				(size 1.27 1.27)
			)
		)
		(uuid "c34f28dc-5637-4543-abf7-106a75d85a45")
	)
	(text "1) Assert ~{SHUTDOWN} = Watchdog reset always asserted, satellite off\n2) Follow ~{SHUTDOWN} = Watchdog resets work as expected\n3) Disable ~{SHUTDOWN} = Ignores watchdog resets if ext power is on"
		(exclude_from_sim no)
		(at 168.402 67.564 0)
		(effects
