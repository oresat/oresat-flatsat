			)
		)
		(uuid "b2b4e83f-12b6-4dbd-94ec-05dcc9ca2f6b")
	)
	(text "VUSB (4.5 5 5.5)V @ (0.5)A"
		(exclude_from_sim no)
		(at 178.816 122.936 0)
