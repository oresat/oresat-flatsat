	)
	(text "Can be powered by combinations of the barrel jack and usb, sensing requires USB power.\nThe bus voltage this card supplies depends on which power source is used.\n	DC jack only   ~7 V bus, no current sensing\n	USB only       5V bus, current sensing\n	USB + jack     ~7V bus, current sensing"
		(exclude_from_sim no)
		(at 243.84 135.636 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "92d281c8-466c-4d3d-9d0c-e1c09efcdbf6")
	)
	(text "Ideal diode for USB"
		(exclude_from_sim no)
		(at 211.328 125.73 0)
		(effects
